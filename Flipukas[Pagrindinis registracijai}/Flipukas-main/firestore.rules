rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId) && isValidId(userId);

      // Personal Wishlist subcollection
      match /wishlist/{wishlistId} {
        allow read, write: if isOwner(userId) && isValidId(wishlistId);

        // Notes and comments on saved 3D design
        match /comments/{commentId} {
          allow read, write: if isOwner(userId) && isValidId(commentId);
        }
      }
    }

    // Community Trending Styles
    match /trending_styles/{styleId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(styleId);
    }

    // Product reviews left by authenticated customers
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(reviewId) && resource.data.userId == request.auth.uid;
    }
  }
}
